      "patch": "@@ -0,0 +1,12 @@\n+package delivery\n+\n+import \"time\"\n+\n+// Policy says how often a failed delivery is retried.\n+type Policy struct {\n+\tAttempts int\n+\tBase     time.Duration\n+}\n+\n+// Wait is the wait before attempt n: Base doubled n-1 times.\n+func (p Policy) Wait(n int) time.Duration { return p.Base << (n - 1) }\n"
