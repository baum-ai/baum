dev_compose := source_directory() / ".." / ".." / "dev-compose.sh"
in_container := "BAUM_OP_RUN=0 " + dev_compose + " run --build --rm --no-deps --workdir /oss/viewer ui-test"
# Type checks, tests and builds take a host-wide heavy-check slot (see dev-compose.sh)
heavy := "BAUM_OP_RUN=0 BAUM_DEV_HEAVY=1 " + dev_compose + " run --build --rm --no-deps --workdir /oss/viewer ui-test"

[private]
default:
    @just --list

lint:
    {{ in_container }} pnpm lint

format-check:
    {{ in_container }} pnpm format:check

typecheck:
    {{ heavy }} pnpm typecheck

test:
    {{ heavy }} pnpm test:unit

# Build the standalone app into ../internal/viewer/dist, which the baum binary embeds
build-app:
    {{ heavy }} pnpm build:app

# Run every check CI runs: lint, format check, typecheck and unit tests
check:
    {{ heavy }} pnpm check

# Browser tests: the standalone app, built and served inside the container
e2e:
    {{ heavy }} pnpm test:e2e

# Run an arbitrary viewer command, including a focused browser spec, in Docker.
[positional-arguments]
pnpm *args:
    {{ heavy }} pnpm "$@"

# Tile gallery: every tile from prompt-eval runs, exported stored reviews and
# hand-edited fixtures, rendered by the real tile components with Vite hot
# reload. Serves http://127.0.0.1:${GALLERY_PORT:-5180}; Ctrl+C stops it.
gallery:
    #!/usr/bin/env sh
    set -eu
    port="${GALLERY_PORT:-5180}"
    root="$(cd {{ source_directory() }}/../.. && pwd)"
    # Created here, as the invoking user, so Docker never creates them as root.
    mkdir -p "$root/tools/prompt-eval/runs" "{{ source_directory() }}/gallery-data/fixtures" "{{ source_directory() }}/gallery-data/stored"
    echo "tile gallery: http://127.0.0.1:$port"
    BAUM_OP_RUN=0 {{ dev_compose }} run --build --rm --no-deps --workdir /oss/viewer \
        -p "127.0.0.1:$port:$port" \
        -v "$root/tools/prompt-eval/runs:/tools/prompt-eval/runs:ro" \
        -e "GALLERY_PORT=$port" -e "GALLERY_HOST_RUNS_DIR=$root/tools/prompt-eval/runs" \
        -e "GALLERY_POLLING=${GALLERY_POLLING:-0}" \
        ui-test pnpm gallery

# Dump the dev database's stored reviews that hold tiles into
# gallery-data/stored for the gallery. Flags: --repository owner/name,
# --kinds a,b, --limit N.
[positional-arguments]
gallery-export *args:
    {{ source_directory() }}/../../tools/prompt-eval/export-stored-tiles.sh "$@"
