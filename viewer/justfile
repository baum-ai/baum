dev_compose := source_directory() / ".." / ".." / "dev-compose.sh"
in_container := "BAUM_OP_RUN=0 " + dev_compose + " run --build --rm --no-deps --workdir /oss/viewer ui-test"

[private]
default:
    @just --list

lint:
    {{ in_container }} pnpm lint

format-check:
    {{ in_container }} pnpm format:check

typecheck:
    {{ in_container }} pnpm typecheck

test:
    {{ in_container }} pnpm test:unit

# Build the standalone app into ../internal/viewer/dist, which is committed
build-app:
    {{ in_container }} pnpm build:app

# Run every check CI runs: lint, format check, typecheck and unit tests
check:
    {{ in_container }} pnpm check
