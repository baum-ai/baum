{
  "schema": "baum.review/1",
  "summary": {
    "text": "Notes gain tags, cleaned once when a note is saved. The store keeps an index of where each tag's notes are, so ByTag reads only those notes instead of scanning the list, and a new notes command lists the notes with a tag. After an automated review, ByTag cleans the tag it is asked for the same way saved tags are cleaned.",
    "review_exchange": {
      "summary": "Codex found that `ByTag` lowercased the tag it was asked for but did not trim it, so `ByTag(\" work\")` missed notes saved as `work`; the third commit fixed it and the thread is resolved. Riley asked who keeps the tag index in step with the notes, and Alex pointed to `Add`'s comment: it is the only writer. Nothing is left open."
    },
    "context": {
      "area": {
        "text": "`notes` is a small library that keeps notes in memory: `Store.Add` saves a note, `List` returns them newest first and `Search` finds them by text. This adds tags to `Note` and a way to list the notes with one.",
        "refs": [
          {
            "path": "store.go",
            "symbol": "Store"
          },
          {
            "path": "note.go",
            "symbol": "Note"
          }
        ]
      },
      "reached_by": {
        "text": "Every note passes through `Store.Add`, which now cleans its tags and records them in the index. `ByTag` is new, and the `notes` command calls it when given `-tag`.",
        "refs": [
          {
            "path": "store.go",
            "symbol": "Store.Add"
          },
          {
            "path": "tags.go",
            "symbol": "Store.ByTag"
          },
          {
            "path": "cmd/notes/main.go",
            "symbol": "main"
          }
        ]
      },
      "contracts": {
        "text": "`Note` is exported, so its new `Tags` field reaches everyone who builds or decodes notes, including the JSON files the command reads. The index holds positions in `notes`, so it stays right only while `Add` is the only code that changes the list.",
        "refs": [
          {
            "path": "note.go",
            "symbol": "Note"
          },
          {
            "path": "store.go",
            "symbol": "Store"
          }
        ]
      },
      "related": {
        "text": "`Search` and `List` are unchanged; `ByTag` sorts its notes the same way `List` does.",
        "refs": [
          {
            "path": "search.go",
            "symbol": "Store.Search"
          },
          {
            "path": "store.go",
            "symbol": "Store.List"
          }
        ]
      }
    },
    "change_kind": "feature",
    "implements": [
      {
        "type": "issue",
        "system": "linear",
        "key": "NOTES-8"
      }
    ],
    "release_note": "Notes can be tagged, and Store.ByTag and notes -tag list the notes with a tag.",
    "breaking_change": null,
    "attention": {
      "text": "The tag index holds positions in the note list and only Add updates it, so the first change that removes or reorders notes has to update it too.",
      "refs": [
        "sec_tags",
        "rsk_index_positions"
      ]
    },
    "authorship": {
      "declared": "ai_assisted",
      "declared_tools": [
        "Claude Code"
      ],
      "anchors": [
        {
          "type": "pr_body"
        }
      ]
    }
  },
