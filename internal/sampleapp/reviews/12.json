            {
              "id": "dec_index",
              "by": "agent",
              "title": "Index tags instead of scanning",
              "text": "The store keeps a map from each tag to its notes' positions, filled by Add, so ByTag reads only the notes it returns.",
              "rationale": "Scanning every note made ByTag slower as the list grew; the author's benchmark shows 2.9 ms per call at 10,000 notes.",
              "rejected": "Scanning every note on each call",
              "trigger": "initiative",
              "anchors": [
                {
                  "type": "hunk",
                  "id": "@store.go"
                },
