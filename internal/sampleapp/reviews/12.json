      },
      "attention": {
        "text": "The index stores positions in notes, and only Add updates it: removing or reordering notes later would make ByTag return the wrong notes.",
        "refs": [
          "rsk_index_positions"
        ]
      },
      "assessment": {
        "level": 3,
        "factors": [
          "public_api"
