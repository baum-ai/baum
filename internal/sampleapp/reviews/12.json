              "id": "dec_clean_once",
              "by": "human",
              "title": "Clean tags once, on save",
              "text": "Tags are cleaned when a note is saved, so every read sees clean tags and nothing cleans them again.",
              "rationale": "Reads are more frequent than writes, and one place for the rule keeps it consistent.",
              "rejected": "Cleaning tags on every read",
