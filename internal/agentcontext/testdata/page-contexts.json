      "context": { "page": "repositories", "repository": "acme/demo", "section": "prompts" }
    },
    {
      "query": "page=repositories&repository=acme%2Fdemo&section=elsewhere",
      "context": { "page": "repositories", "repository": "acme/demo", "section": "reviews" }
    },
    {
