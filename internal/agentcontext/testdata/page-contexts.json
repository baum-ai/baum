{
  "description": "The page context the app derives from its address (oss/app/src/page-context.ts, pageContextOf), and which the MCP server must take (PageContext.Validate, and link for its page and subject). clones names the repository of each clone id the app knows.",
  "clones": { "c1": "acme/demo" },
  "cases": [
    { "query": "", "context": { "page": "inbox" } },
    { "query": "inbox=abc", "context": { "page": "inbox" } },
    { "query": "page=inbox-new", "context": { "page": "inbox" } },
    { "query": "page=nowhere", "context": { "page": "inbox" } },
    {
      "query": "page=pulls&filter=all&q=author%3A%40me",
      "context": { "page": "pulls", "filters": { "filter": "all", "q": "author:@me" } }
    },
    { "query": "page=timeline&who=human", "context": { "page": "timeline", "filters": { "who": "human" } } },
    { "query": "page=sessions", "context": { "page": "sessions" } },
    { "query": "page=sessions&peek=claude-code%3As1", "context": { "page": "sessions" } },
    { "query": "page=analytics", "context": { "page": "analytics" } },
    { "query": "page=jobs", "context": { "page": "jobs" } },
    {
      "query": "repository=acme%2Fdemo&pr=7",
