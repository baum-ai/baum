    },
    {
      "query": "clone=c1&pr=7&walk=b2",
      "hash": "#sec_rest",
      "context": {
        "page": "pull_request",
        "repository": "acme/demo",
        "pull_request": 7,
        "focus": { "walk": "b2", "anchor": "sec_rest" }
