    { "query": "page=jobs&job=j1", "context": { "page": "job", "job": "j1" } },
    { "query": "page=timeline&feature=f1", "context": { "page": "feature", "feature": "f1" } },
    { "query": "page=settings", "context": { "page": "settings", "section": "general" } },
    { "query": "page=settings&section=fixes", "context": { "page": "settings", "section": "fixes" } },
    { "query": "page=settings&section=unknown", "context": { "page": "settings", "section": "general" } },
    { "query": "page=diagnostics", "context": { "page": "settings", "section": "computer" } },
    { "query": "page=repositories", "context": { "page": "repositories" } },
    {
