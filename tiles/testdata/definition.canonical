{"data_schema":{"additionalProperties":false,"properties":{"routes":{"items":{"additionalProperties":false,"properties":{"breaking":{"type":["boolean","null"]},"cites":{"items":{"$ref":"#/$defs/citation"},"maxItems":4,"minItems":1,"type":"array"},"method":{"enum":["GET","POST","PUT","DELETE"]},"path":{"description":"The route’s pattern, café   style.","maxLength":200,"type":"string"},"weight":{"maximum":1000,"minimum":0.5,"type":"number"}},"required":["method","path","cites"],"type":"object"},"maxItems":20,"type":"array"},"summary":{"$ref":"#/$defs/markdown"}},"required":["summary","routes"],"type":"object"},"fill":"List each changed route.\nCite the hunk that registers it, with \"lines\" covering the registration.","kit":1,"name":"api_surface","sizes":["half","full"],"source":{"format":"html","html":"<style>.route { font: var(--font-mono); }</style>\n<script>\nbaum.tile({\n  glance: (v) => baum.html`<p class=\"kit-lede\">${v.data.routes.length} routes</p>`,\n  detail: (v) => baum.html`${baum.md(v.data.summary)}`,\n});\n</script>\n"},"title":"API surface","use_when":"When the pull request adds, removes or changes an HTTP route (not internal functions)."}
