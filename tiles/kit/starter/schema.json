{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "items"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "One or two sentences in the Markdown subset."
    },
    "items": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "severity", "text", "cites"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "severity": { "enum": ["high", "medium", "low"] },
          "text": { "type": ["string", "null"], "maxLength": 600, "description": "Markdown subset; null when the title says it all." },
          "cites": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "$ref": "#/$defs/hunk" }
          }
        }
      }
    }
  },
  "$defs": {
    "hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "hunk" },
        "id": { "$ref": "#/$defs/hunkId" },
        "lines": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } }
      }
    }
  }
}
