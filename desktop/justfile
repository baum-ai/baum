dev_compose := source_directory() / ".." / ".." / "dev-compose.sh"
heavy := "BAUM_OP_RUN=0 BAUM_DEV_HEAVY=1 " + dev_compose + " run --build --rm --no-deps"
electron := heavy + " desktop-electron"

# Format check, typecheck, unit tests and the updater signing, manifest and
# update file checks
check: electron-cache
    {{ electron }} sh -ec 'pnpm check && bash scripts/updater-manifest-test.sh && bash scripts/update-yml-test.sh'

# The unit tests; pass vitest arguments after it
test *args: electron-cache
    {{ electron }} pnpm exec vitest run {{ args }}

# The shell's harness (tests/shell): builds the shell and runs it under Xvfb
# against a mock daemon. Needs dist/ (just desktop::frontend).
shell-test *args: electron-cache
    {{ electron }} sh -c 'pnpm build && pnpm test:shell "$@"' -- {{ args }}

fmt: electron-cache
    BAUM_OP_RUN=0 {{ dev_compose }} run --build --rm --no-deps desktop-electron pnpm format

# Vite's build mode for the frontend: BAUM_FRONTEND_MODE=profile builds the
# profiling build (oss/app/README.md), which the sidecar then embeds.
frontend_mode := env("BAUM_FRONTEND_MODE", "production")

# Bundle the React application and native setup screen in the UI container.
frontend mode=frontend_mode:
    {{ heavy }} --workdir /oss/app ui-test pnpm exec vite build --mode {{ mode }}

# Build the viewer the bundled baum embeds, which frontend leaves out
[private]
viewer:
    {{ heavy }} --workdir /oss/viewer ui-test pnpm build:app

# Build the bundled baum binary into binaries/ (default: the container's platform)
sidecar target="":
    {{ heavy }} oss-test sh desktop/scripts/sidecar.sh {{ target }}

# Build the unpacked Linux app (electron-builder --dir) into
# target/electron-builder/linux-unpacked
build: frontend sidecar electron-cache
    {{ electron }} scripts/bundle.sh --dir linux-amd64 0.0.0 target/release-bundles

# Build the Linux release bundles (deb, AppImage, latest-linux.yml) into
# target/release-bundles as the release workflow does, without updater
# signatures. The version defaults to a snapshot's.
bundle version="0.0.0": frontend sidecar electron-cache
    {{ electron }} scripts/bundle.sh linux-amd64 {{ version }} target/release-bundles

# Build an ad hoc signed macOS DMG into target/local-dmg (--install also installs it)
dmg *args: frontend viewer (sidecar "aarch64-apple-darwin") (sidecar "x86_64-apple-darwin")
    scripts/macos-local.sh {{ args }}

# The download caches the desktop-electron service mounts
[private]
electron-cache:
    @mkdir -p "${BAUM_DEV_CACHE_DIR:-$HOME/.cache/baum-dev}/electron" "${BAUM_DEV_CACHE_DIR:-$HOME/.cache/baum-dev}/electron-builder"

dmg_layout_packages := "ds-store==1.3.3 mac-alias==2.2.3 numpy==2.5.4 pillow==13.0.0 tifffile==2026.10.15"

# Regenerate macos/dmg.DS_Store and macos/dmg-background.tiff, the Finder
# window layout of the macOS DMG
dmg-layout:
    docker run --rm ${BAUM_DEV_CPUSET:+--cpuset-cpus="$BAUM_DEV_CPUSET"} \
        --user "$(id -u):$(id -g)" -e HOME=/tmp -v "{{ source_directory() }}:/desktop" -w /desktop \
        python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30 \
        sh -ec 'pip install --quiet --disable-pip-version-check --target /tmp/py {{ dmg_layout_packages }} && PYTHONPATH=/tmp/py python scripts/dmg-layout.py'

# Regenerate ../third_party/electron.txt: Electron's licence and the npm
# packages the app ships (just third-party-notices does the rest)
notices: electron-cache
    {{ electron }} scripts/third-party-notices.sh

# Check that scripts/updater-manifest.sh rejects tampered releases
updater-test: electron-cache
    {{ electron }} bash scripts/updater-manifest-test.sh

# Regenerate icons/ from icons/source.svg, and the tray icons from
# icons/tray/*.svg: palette tokens resolved and drawn by the ui-test image's
# Chromium, then the PNG, ICNS and ICO files written with Pillow
icons:
    {{ heavy }} --workdir /oss/app ui-test sh -ec 'node ../desktop/scripts/prepare-icons.mjs && node ../desktop/scripts/rasterize-icons.mjs'
    docker run --rm ${BAUM_DEV_CPUSET:+--cpuset-cpus="$BAUM_DEV_CPUSET"} \
        --user "$(id -u):$(id -g)" -e HOME=/tmp -v "{{ source_directory() }}:/desktop" -w /desktop \
        python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30 \
        sh -ec 'pip install --quiet --disable-pip-version-check --target /tmp/py {{ icon_packages }} && PYTHONPATH=/tmp/py python scripts/icons.py'

icon_packages := "pillow==13.0.0"

# Run the Electron app on the Linux or macOS host, with its build and Vite hot
# reload in Docker
dev: frontend electron-cache
    sh {{ source_directory() }}/scripts/dev.sh

# Run the app on this Wayland display, with the container's own home and daemon
run: frontend sidecar electron-cache
    BAUM_OP_RUN=0 {{ dev_compose }} run --build --rm --no-deps \
        -v "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:/tmp/wayland-0" \
        -e XDG_RUNTIME_DIR=/tmp -e WAYLAND_DISPLAY=wayland-0 \
        desktop-electron sh -c 'pnpm build && exec pnpm exec electron . --ozone-platform=wayland'

# Run the app with its own home, keyring and daemon beside the installed one,
# one per name (scripts/isolated.sh; --copy-data copies this machine's data,
# --seed-data writes the seeded profiling dataset)
isolated *args: frontend viewer sidecar electron-cache
    sh {{ source_directory() }}/scripts/isolated.sh {{ args }}

# Run a scripted journey against the headless app N times after a warm-up,
# with the profiling build and a CPU profile per run, and write summary.md
# and metrics.json under target/profile (scripts/profile.sh; --copy-data and
# --workspace as isolated; --baseline REF also builds REF and says what
# changed beyond noise)
profile *args: (profile-check args) (frontend "profile") viewer sidecar electron-cache
    sh {{ source_directory() }}/scripts/profile.sh {{ args }}

# The profile's arguments, checked before anything is built
[private]
profile-check args:
    sh {{ source_directory() }}/scripts/profile.sh --check {{ args }}

# Save a PNG of a running --headless isolated app's screen
isolated-screenshot name="default" out="isolated-screenshot.png":
    #!/bin/sh
    set -eu
    docker exec baum-desktop-{{ name }} import -display :99 -window root /tmp/isolated-screenshot.png
    cd "{{ invocation_directory() }}"
    docker cp -q "baum-desktop-{{ name }}:/tmp/isolated-screenshot.png" "{{ out }}"
    echo "{{ out }}"

# A login shell in a running isolated app's container, on its D-Bus session
isolated-shell name="default":
    docker exec -it baum-desktop-{{ name }} sh -c 'DBUS_SESSION_BUS_ADDRESS=$(cat /tmp/runtime/bus) XDG_RUNTIME_DIR=/tmp/runtime exec bash -l'
