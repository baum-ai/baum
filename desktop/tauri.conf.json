{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "baum",
  "mainBinaryName": "baum-desktop",
  "version": "0.0.0",
  "identifier": "com.usebaum.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "capabilities": ["connecting-screen"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Keep up with what your coding agents build",
    "externalBin": ["binaries/baum"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
