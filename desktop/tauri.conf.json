{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "baum",
  "mainBinaryName": "baum-desktop",
  "version": "0.0.0",
  "identifier": "com.usebaum.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-ancestors": "'none'"
      },
      "capabilities": ["connecting-screen", "setup-screen"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "DeveloperTool",
    "shortDescription": "Keep up with what your coding agents build",
    "copyright": "Copyright (c) 2026 Baum AI Ltd",
    "license": "MIT",
    "externalBin": ["binaries/baum"],
    "resources": {
      "../LICENSE": "LICENSE",
      "THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 (>= 2.38)"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0MkFDRjc3NEZDQzFENUYKUldSZkhjeFBkODhxeEh0eWRKWTdxbkEzVHJQM1k5NmVteGxJODdWT2JpRElRWXBhZlEzT0phZnYK",
      "endpoints": ["https://github.com/baum-ai/baum/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
