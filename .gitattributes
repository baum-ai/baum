# Check text files out with LF on every platform: golden files are compared
# byte-for-byte, and a CRLF checkout on Windows would break them.
* text=auto eol=lf

*.db binary
*.db-wal binary
*.vscdb binary

# The built standalone viewer is generated by "pnpm build:app".
internal/viewer/dist/** linguist-generated=true -diff

internal/localapp/dist/** linguist-generated=true -diff
