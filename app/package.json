{
  "name": "@baum/local-app",
  "private": true,
  "version": "0.0.0",
  "description": "React components that render a baum.review/1 document and its versions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:profile": "vite build --mode profile",
    "lint:palette": "node scripts/check-palette.mjs",
    "tile-kit": "node scripts/build-tile-kit.mjs",
    "tile-kit:check": "node scripts/build-tile-kit.mjs --check",
    "lint": "pnpm lint:palette && oxlint --deny-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "node --test scripts/check-palette.test.mjs && vitest run && KIT_SCRIPT=inlined vitest run src/tile-kit",
    "test:e2e": "playwright test",
    "test:desktop": "node ../desktop/tests/onboarding.cjs",
    "test:development": "playwright test --config playwright.development.config.ts",
    "check": "pnpm lint && pnpm format:check && pnpm tile-kit:check && pnpm typecheck && pnpm test:unit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "24.13.2",
    "@types/pluralize": "^0.0.33",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "http-proxy-3": "^2.0.1",
    "jsdom": "30.1.0",
    "oxlint": "1.73.0",
    "pluralize": "^8.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@baum/viewer": "link:../viewer"
  }
}
