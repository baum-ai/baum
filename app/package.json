{
  "name": "@baum/local-app",
  "private": true,
  "version": "0.0.0",
  "description": "React components that render a baum.review/1 document and its versions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "generate": "pnpm --dir ../viewer generate",
    "typecheck": "pnpm generate && tsc --noEmit",
    "build": "pnpm generate && vite build",
    "lint": "oxlint --deny-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "24.13.2",
    "@types/pluralize": "^0.0.33",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "^8.20.0",
    "jsdom": "30.1.0",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "1.73.0",
    "pluralize": "^8.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@baum/viewer": "link:../viewer"
  }
}
